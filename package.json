{
  "name": "conject",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small research-oriented package with tools and skills for Conject workflows.",
  "keywords": [
    "research",
    "agents"
  ],
  "bin": {
    "conject": "./dist/cli.js"
  },
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "link:cli": "npm run build && npm link"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.76.0",
    "@earendil-works/pi-tui": "0.76.0",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
